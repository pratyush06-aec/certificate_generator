# Example secrets.toml for Google Drive integration
# Copy your downloaded Service Account JSON key values here

GDRIVE_PARENT_FOLDER_ID = ""  # (Optional) ID of a shared folder in your personal Drive

[gdrive_service_account]
type = "service_account"
project_id = "certificate-generation-auto"
private_key_id = "your_private_key_id"
private_key = "-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"
client_email = "drive-cert-uploader@certificate-generation-auto.iam.gserviceaccount.com"
client_id = "your_client_id"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/drive-cert-uploader%40certificate-generation-auto.iam.gserviceaccount.com"
